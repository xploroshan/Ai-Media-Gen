# Copy to .env and fill in. Web validates via zod (apps/web/src/lib/env.ts),
# worker via pydantic (services/worker/worker/lib/settings.py); both fail fast at boot.

DATABASE_URL=postgresql://reelforge:reelforge@localhost:5432/reelforge

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_DERIVED=derived
S3_BUCKET_RENDERS=renders
S3_BUCKET_GENERATED=generated

AUTH_SECRET=change-me-32-chars-minimum-secret

# optional — Google OAuth (login button hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# optional — absent => OTP logged to web server console (dev mode)
RESEND_API_KEY=

# optional — absent => StubProvider for all AI generation (dev/CI default)
FAL_KEY=

WORKER_CONCURRENCY=2
APP_URL=http://localhost:3000
